# Copy to .env (git-ignored). Real values never go in git.

# Local Postgres from docker-compose (port 5434)
DATABASE_URL=postgresql://keel:keel@localhost:5434/keel

# Signs session cookies and the assistant's per-call tokens. Any long random string;
# `openssl rand -base64 32` makes one.
SESSION_SECRET=

# The assistant. Without a key everything else works and the panel says it's off.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default), claude-haiku-5-5 or claude-opus-5-5
KEEL_MODEL=claude-sonnet-5-5

# Public demo mode: Claude Haiku for visitors and tighter limits
KEEL_DEMO=0
KEEL_RUNS_PER_HOUR=200

# Used in links (MCP approval links, Connect page)
APP_URL=http://localhost:3100

# Optional: export traces over OpenTelemetry (OTLP/HTTP)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
